# liquidation.env — template for /etc/liquidation/liquidation.env (chmod 600)
# Loaded by the systemd unit (deploy/systemd/liquidation.service) and the Docker
# entrypoint. Fill in secrets, then: sudo systemctl restart liquidation
#
# Required — Robinhood chain (4663)
RPC_URL_4663=
EXECUTOR_ADDRESS_4663=
LIQUIDATION_PRIVATE_KEY_4663=

# Recommended — backup RPCs (strict priority) and push-based watching
RPC_URL_4663_FALLBACKS=https://rpc.mainnet.chain.robinhood.com
WS_RPC_URL_4663=

# Optional — health endpoint (default 3000, loopback only)
HEALTH_PORT=3000

# Run-mode knobs (DRY_RUN / METRICS_PATH) come from the systemd drop-in:
#   soak:   deploy/systemd/soak.conf   → DRY_RUN=true,  metrics-soak.jsonl
#   golive: deploy/systemd/golive.conf → DRY_RUN=false, metrics.jsonl
# Do not set them here — the drop-in is the single source of truth for the mode.
