# Morpho Blue Liquidation Bot — environment configuration
#
# Copy to `.env` and fill in your values. Per-chain variables use the pattern
# `<VAR>_<chainId>`; the bot scans `apps/config/src/config.ts` chainConfigs
# for the configured chains. Docker/Railway deployments build their own .env
# from injected vars (see Dockerfile) — this file is for bare-metal/VPS runs.
#
# Configured chains: 1 (mainnet), 130 (unichain), 8453 (base), 747474 (katana),
# 999 (HyperEVM), 143 (monad), 4217 (tempo), 4663 (Robinhood Chain).

# ── Per-chain secrets (required, one block per chain you run) ────────────────

# Primary HTTP RPC for the chain (fallback: the viem chain's built-in default).
RPC_URL_1=https://eth-mainnet.g.alchemy.com/v2/<ALCHEMY_API_KEY>
# Optional: backup RPCs, tried in strict priority order when the primary fails.
RPC_URL_1_FALLBACKS=https://eth.drpc.org,https://eth.llamarpc.com
# Address of your deployed executor contract (see README: `pnpm deploy:executor`).
EXECUTOR_ADDRESS_1=0x1234567890123456789012345678901234567890
# EOA key that signs liquidations (and funds executor gas top-ups).
LIQUIDATION_PRIVATE_KEY_1=0x1234567890123456789012345678901234567890123456789012345678901234

RPC_URL_8453=https://base-mainnet.g.alchemy.com/v2/<ALCHEMY_API_KEY>
EXECUTOR_ADDRESS_8453=0x1234567890123456789012345678901234567890
LIQUIDATION_PRIVATE_KEY_8453=0x1234567890123456789012345678901234567890123456789012345678901234

# Production chain — Robinhood Chain (see RUNBOOK.md)
RPC_URL_4663=https://rpc.robinhoodchain.com
# Optional WebSocket RPC: pushes new blocks instead of HTTP polling (lower latency).
# WS_RPC_URL_4663=wss://<your-ws-endpoint>

# ── Runtime toggles ──────────────────────────────────────────────────────────

# true = simulate-only: never signs or broadcasts liquidations. Used for the
# 24h soak test before go-live (RUNBOOK.md). Default: false.
DRY_RUN=false

# Where trade/scan metrics are appended as JSON lines (dashboards, soak diffs).
# METRICS_PATH=./metrics.jsonl

# HTTP health endpoint for liveness probes (also: PORT, HEALTH_SERVER_HOST).
# HEALTH_PORT=3000

# ── Execution (optional) ─────────────────────────────────────────────────────

# Separate EOA key for Flashbots private-orderflow submissions (mainnet bundles).
# FLASHBOTS_PRIVATE_KEY=0x...

# ── Liquidity venue API keys (optional — venues work rate-limited without one)

# Li.Fi aggregator
# LIFI_API_KEY=
# 0x Swap API (v2)
# ZERO_EX_API_KEY=
# 1inch
# ONE_INCH_SWAP_API_KEY=

# ── Alerting (optional) ──────────────────────────────────────────────────────

# Telegram trade alerts + UTC-midnight daily report
# TELEGRAM_BOT_TOKEN=123456789:AAYourBotFatherTokenHere
# TELEGRAM_CHAT_ID=123456789
# Multi-subscriber access: generate with `openssl rand -hex 16`.
# Anyone sending /start <secret> to the bot subscribes to all reports.
# TELEGRAM_SHARED_SECRET=
# Where subscribed chat IDs are persisted (default: ./telegram-subscribers.json)
# TELEGRAM_SUBSCRIBERS_PATH=/path/to/telegram-subscribers.json

# ── Local validation helpers (optional) ─────────────────────────────────────

# Radar threshold override used by `pnpm validate:4663` (bps; default 11500).
# PRE_LIQUIDATION_HEALTH_FACTOR_THRESHOLD_BPS=11500
